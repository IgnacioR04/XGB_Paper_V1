# Copia este archivo a .env y rellena lo que necesites.
# .env NO se sube a git.

# Solo necesaria para que el bot recupere series FRED (DXY, M2, CPI, US10Y, US2Y, fed_funds).
# Sin esta key, los features macro de FRED quedan en NaN (el modelo XGB lo tolera).
# Obtenla gratis en https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# Las dos siguientes NO son necesarias para paper trading (solo datos publicos de Binance).
# Estan aqui solo para preparar la transicion a live trading futuro.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Override opcional: ruta a un master_15m_latest.parquet ya construido.
# Si esta seteado y feature_mode = "latest_master_snapshot", se usa esta ruta.
MASTER_SNAPSHOT_PATH=
